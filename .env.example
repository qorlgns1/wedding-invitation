# Kakao JavaScript key (optional for Kakao share)
VITE_KAKAO_APP_KEY=your_kakao_javascript_key

# Optional: override production base path (default: /wedding-invitation/)
# VITE_BASE_PATH=/wedding-invitation/

# ---------------------------------------------------------------------------
# 실제 청첩장 정보. 아래 값을 비워두면 저장소에는 커밋되지 않는, 명백히
# 가짜인 데모 데이터(이름/날짜/장소/계좌)가 표시됩니다 (포트폴리오 안전).
# 실제 청첩장으로 배포할 때만 이 파일을 복사한 로컬 .env(또는 배포 파이프라인의
# secrets)에 실제 값을 채우세요. .env는 .gitignore에 포함되어 커밋되지 않습니다.
# ---------------------------------------------------------------------------

# 신랑/신부 인적사항
VITE_GROOM_NAME_KR=
VITE_GROOM_NAME_EN=
VITE_GROOM_DISPLAY_NAME=
VITE_GROOM_BIRTH_ORDER=
VITE_GROOM_FATHER_NAME=
VITE_GROOM_MOTHER_NAME=

VITE_BRIDE_NAME_KR=
VITE_BRIDE_NAME_EN=
VITE_BRIDE_DISPLAY_NAME=
VITE_BRIDE_BIRTH_ORDER=
VITE_BRIDE_FATHER_NAME=
VITE_BRIDE_MOTHER_NAME=

# 예식 일시 (VITE_WEDDING_DATE: YYYY-MM-DD, VITE_WEDDING_TIME: 24시간제 HH:mm)
VITE_WEDDING_DATE=
VITE_WEDDING_TIME=

# 예식 장소
VITE_VENUE_NAME=
VITE_VENUE_ADDRESS=
VITE_VENUE_FULL_ADDRESS=

# 초대의 글 (HTML <br> 사용 가능)
VITE_LETTER_CONTENT=

# 브라우저 탭 제목 / 카카오톡·SNS 공유 미리보기(Open Graph)
# VITE_META_IMAGE는 크롤러가 접근 가능한 절대 URL을 권장합니다.
VITE_PAGE_TITLE=
VITE_META_TITLE=
VITE_META_DESCRIPTION=
VITE_META_IMAGE=

# 계좌번호. 은행명/번호 쌍을 모두 비우면 데모용 가짜 계좌가 표시됩니다.
VITE_ACCOUNT_GROOM_FATHER_BANK=
VITE_ACCOUNT_GROOM_FATHER_NUMBER=
VITE_ACCOUNT_GROOM_MOTHER_BANK=
VITE_ACCOUNT_GROOM_MOTHER_NUMBER=
VITE_ACCOUNT_GROOM_BANK=
VITE_ACCOUNT_GROOM_NUMBER=

VITE_ACCOUNT_BRIDE_FATHER_BANK=
VITE_ACCOUNT_BRIDE_FATHER_NUMBER=
VITE_ACCOUNT_BRIDE_MOTHER_BANK=
VITE_ACCOUNT_BRIDE_MOTHER_NUMBER=
VITE_ACCOUNT_BRIDE_BANK=
VITE_ACCOUNT_BRIDE_NUMBER=
